# ── AI Provider (swap anytime without touching code) ──────────────────
# Option 1: Ollama — local, free forever (default)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2

# Option 2: Groq — cloud free tier, fast (uncomment to use)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your_key_here
# AI_MODEL=llama-3.3-70b-versatile

# Option 3: OpenRouter — many free models (uncomment to use)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-your_key_here
# AI_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ── Other ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-in-production
